# Configuración para Thumbnail Generator
# Copia este archivo a .env y configura tus valores

# Clave secreta de Flask (genera una única para producción)
# Puedes generar una con: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=thumbnail_generator_secure_key_change_me

# Ruta de la base de datos (se usa en Docker para persistencia)
DATABASE_PATH=/app/db_data/thumbnail_users.db
