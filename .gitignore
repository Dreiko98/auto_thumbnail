# =============================================================================
# ARCHIVOS ESPECÍFICOS DEL PROYECTO
# =============================================================================

# Archivos de configuración que pueden contener datos sensibles
config.json
settings.json
secrets.json

# Archivos de ejemplo que no deben versionarse
*ejemplo*
*demo*
*test*

# Archivos de deployment específicos del servidor
deploy_config.sh
server_config.sh

# Archivos de monitoreo
monitor_output.txt
status.log

# =============================================================================
# EXCEPCIONES (archivos que SÍ queremos versionar)
# =============================================================================

# Mantener estas carpetas pero vacías
!.uploads/.gitkeep
!.results/.gitkeep
!uploads/.gitkeep
!thumbnails/.gitkeep

# Mantener archivos de ejemplo en la documentación
!docs/ejemplos/
!static/
!templates/

# Archivos de configuración de ejemplo
!config.example.json
!.env.example